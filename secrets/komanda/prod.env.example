# Template for /run/secrets/komanda/prod.env
# Copy outside version control, fill real values, chmod 600.
# Names and requirements are declared in src/lib/config/index.ts.

# --- Core ---------------------------------------------------------------
KOMANDA_PUBLIC_BASE_URL=https://app.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com
STOREFRONT_ROOT_DOMAIN=example.com
KOMANDA_CORE_URL=http://fastify:3001
KOMANDA_BUSINESS_SERVICE_TOKEN=
KOMANDA_SERVICE_VERSION=
CRON_SECRET=
TZ=America/Argentina/Buenos_Aires

# --- Telemetry (required: prod fails fast without these) ----------------
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64(instance-id:token)>
KOMANDA_TELEMETRY_IDENTIFIER_KEY=
OTEL_TRACES_SAMPLER_ARG=0.1

# --- Database -----------------------------------------------------------
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_PROVIDER=supabase
DATABASE_POOL_MAX=10

# --- Object storage -----------------------------------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PUBLIC_BASE_URL=

# --- Identity / crypto --------------------------------------------------
APP_ENCRYPTION_KEY_BASE64=
APP_ENCRYPTION_KEY_VERSION=1
IDENTITY_VERIFICATION_DELIVERY=resend
IDENTITY_VERIFICATION_FROM_EMAIL=
IDENTITY_VERIFICATION_RESEND_KEY=

# --- Payments -----------------------------------------------------------
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_REDIRECT_URI=

# --- WhatsApp (optional) ------------------------------------------------
KOMANDA_WHATSAPP_ACCESS_TOKEN=
KOMANDA_WHATSAPP_PHONE_NUMBER_ID=
KOMANDA_WHATSAPP_READY_TEMPLATE=
KOMANDA_WHATSAPP_OWNER_CASH_TEMPLATE=
