# Template for /run/secrets/komanda/stg.env
# Copy outside version control, fill staging-only values, chmod 600.
# Names and requirements are declared in src/lib/config/index.ts.

KOMANDA_PUBLIC_BASE_URL=https://stg.example.com
NEXT_PUBLIC_SITE_URL=https://stg.example.com
STOREFRONT_ROOT_DOMAIN=stg.example.com
KOMANDA_CORE_URL=http://fastify:3001
KOMANDA_BUSINESS_SERVICE_TOKEN=
KOMANDA_SERVICE_VERSION=
CRON_SECRET=
TZ=America/Argentina/Buenos_Aires

# Telemetry is required in stg too, with staging-only credentials.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64(instance-id:token)>
KOMANDA_TELEMETRY_IDENTIFIER_KEY=
# Full sampling is acceptable in staging; keep volume within the Cloud quota.
OTEL_TRACES_SAMPLER_ARG=1

DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_PROVIDER=supabase
DATABASE_POOL_MAX=5

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PUBLIC_BASE_URL=

APP_ENCRYPTION_KEY_BASE64=
APP_ENCRYPTION_KEY_VERSION=1
IDENTITY_VERIFICATION_DELIVERY=capture
IDENTITY_VERIFICATION_CAPTURE_PATH=.test-artifacts/verification.jsonl

MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_REDIRECT_URI=
