NODE_ENV=production
KOMANDA_ENVIRONMENT=production

KOMANDA_PUBLIC_BASE_URL=https://app.komanda.app
STOREFRONT_ROOT_DOMAIN=komanda.app
KOMANDA_BUSINESS_SERVICE_TOKEN=replace-with-32-plus-byte-secret
KOMANDA_BUSINESS_PREVIOUS_SERVICE_TOKEN=

# Azure PostgreSQL Flexible Server. Values come from infra/database/azure/production outputs.
DATABASE_DIRECT_URL=postgresql://komanda_migration:REPLACE@komanda-pg-production-unique.postgres.database.azure.com:5432/komanda?sslmode=require
DATABASE_URL=postgresql://komanda_runtime:REPLACE@komanda-pg-production-unique.postgres.database.azure.com:5432/komanda?sslmode=require
DATABASE_EXPECTED_HOST=komanda-pg-production-unique.postgres.database.azure.com
DATABASE_RUNTIME_PASSWORD=replace-with-32-plus-byte-runtime-password
DATABASE_POOL_MAX=20

APP_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
APP_ENCRYPTION_KEY_VERSION=1

# Production cannot use capture. Point this to the reviewed email-delivery service.
IDENTITY_VERIFICATION_DELIVERY=http
IDENTITY_VERIFICATION_HTTP_ENDPOINT=https://internal-mailer.example.com/komanda/identity-verifications
IDENTITY_VERIFICATION_HTTP_TOKEN=replace-with-32-plus-byte-secret

OBJECT_STORAGE_ENDPOINT=https://replace-with-storage-endpoint
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=komanda-production-media
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=false

MERCADOPAGO_CLIENT_ID=replace-with-mp-client-id
MERCADOPAGO_CLIENT_SECRET=replace-with-mp-client-secret
MERCADOPAGO_REDIRECT_URI=https://app.komanda.app/api/v1/integrations/mercadopago/oauth/callback
MERCADOPAGO_WEBHOOK_SECRET=replace-with-mp-webhook-secret
