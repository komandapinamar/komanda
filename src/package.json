{
  "name": "KOMANDA CORPORATION",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contracts": "vitest run --project contract",
    "test:tenant-isolation": "vitest run --project tenant-isolation",
    "test:database-compatibility": "vitest run --project database-compatibility",
    "test:database-compatibility:postgres": "DATABASE_TEST_INTEGRATION=1 vitest run --project database-compatibility",
    "test:database-compatibility:gcp-staging": "DATABASE_TARGET=gcp-staging DATABASE_PROVIDER=gcp DATABASE_TEST_INTEGRATION=1 vitest run --project database-compatibility",
    "test:database-compatibility:gcp-production": "DATABASE_TARGET=gcp-production DATABASE_PROVIDER=gcp DATABASE_TEST_INTEGRATION=1 vitest run --project database-compatibility",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/multitenant.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify-migration-journal": "tsx scripts/verify-migration-journal.ts",
    "db:restore-drill": "tsx scripts/database-restore-drill.ts",
    "db:prepare": "tsx scripts/prepare-database.ts",
    "db:prepare:gcp": "DATABASE_PROVIDER=gcp tsx scripts/prepare-database.ts",
    "db:migrate:test": "tsx scripts/migrate-test-database.ts",
    "db:bootstrap-roles": "tsx scripts/database-role-bootstrap.ts",
    "db:verify-roles:test": "tsx scripts/verify-database-roles.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "env:verify": "tsx scripts/verify-runtime-environment.ts",
    "seed:multitenant:acceptance": "tsx scripts/seed-multitenant-acceptance.ts",
    "seed:dev": "tsx scripts/seed-dev-tenant.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@mercadopago/sdk-react": "^1.0.7",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.2",
    "mercadopago": "^3.2.0",
    "next": "^16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vite": "^8.1.3",
    "vitest": "^4.1.0"
  }
}
