# Never point tests at production systems or credentials.
NODE_ENV=test
KOMANDA_TEST_MODE=1
KOMANDA_CORE_URL=http://127.0.0.1:3000
KOMANDA_BUSINESS_SERVICE_TOKEN=test-only-komanda-business-token-32-bytes

# PostgreSQL: migration/owner and least-privilege runtime roles must differ.
DATABASE_DIRECT_URL=postgresql://komanda_migration:change-me@127.0.0.1:5432/komanda_test
DATABASE_URL=postgresql://komanda_runtime:change-me@127.0.0.1:5432/komanda_test
DATABASE_MIGRATION_ROLE=komanda_migration
DATABASE_RUNTIME_ROLE=komanda_runtime

# Deterministic non-production provisioning fixture. The seed command must hard-fail
# whenever NODE_ENV=production regardless of these values.
MOCK_TENANT_ID=00000000-0000-4000-8000-000000000001
MOCK_TENANT_SLUG=tenant-mock
MOCK_OWNER_EMAIL=owner.mock@example.test
MOCK_PLAN_ID=development

# Application cryptography. Use a random 32-byte base64 value in real environments.
APP_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_ENCRYPTION_KEY_VERSION=1

# S3-compatible isolated test storage.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=komanda-test
OBJECT_STORAGE_ACCESS_KEY_ID=test-only
OBJECT_STORAGE_SECRET_ACCESS_KEY=test-only
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Verification delivery capture sink; no real customer email is sent.
IDENTITY_VERIFICATION_DELIVERY=capture
IDENTITY_VERIFICATION_CAPTURE_PATH=.test-artifacts/verification.jsonl

# Mercado Pago sandbox only. Never place production seller tokens in this file.
MERCADOPAGO_CLIENT_ID=test-client-id
MERCADOPAGO_CLIENT_SECRET=test-client-secret
MERCADOPAGO_REDIRECT_URI=http://127.0.0.1:3000/api/v1/integrations/mercadopago/oauth/callback
MERCADOPAGO_WEBHOOK_SECRET=test-webhook-secret

# Print tests use a fake printer and scoped fixture tokens.
PRINT_ADAPTER=fake
PRINT_AGENT_A_TOKEN=test-agent-a
PRINT_AGENT_B_TOKEN=test-agent-b
